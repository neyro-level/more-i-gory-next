AMS_PROFILE=REALTY_BASE
TZ=Europe/Moscow
JOBS_AUTORUN=false
AMS_RUNTIME_CONTOUR=staging
DATABASE_URI=postgresql://moreigori_app:replace-me@127.0.0.1:5432/moreigori_dev
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000

# Enable only with the matching module. Conditional validation then requires the related fields.
# CACHE_INVALIDATION_MODE=http
# REVALIDATE_SECRET=replace-with-at-least-32-random-characters
# INTERNAL_REVALIDATE_BASE_URL=http://127.0.0.1:3000
# S3 is optional locally. NODE_ENV=production runtime fail-fast requires all five keys.
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_BUCKET=moreigory-media
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# Staging contour uses prefix staging/media on the same bucket; production uses media.
# S3_MEDIA_PREFIX=staging/media
# OUTBOUND_ALLOWED_HOSTS=example.invalid
# LEAD_CHANNELS=telegram
# LEAD_OUTBOUND_HOSTS=api.telegram.org
# TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_CHAT_ID=replace-me
# ALERT_WEBHOOK_URL=https://alerts.example.invalid/hook

# Optional named feed URL refs (not required). Ingest stays frozen until an explicit owner command.
# FEED_URL_PRIMARY=https://feeds.example.invalid/primary.xml

# Public build-time switch. Keep false until the Leads API, legal texts and E2E delivery gate are approved.
NEXT_PUBLIC_LEADS_ENABLED=false
