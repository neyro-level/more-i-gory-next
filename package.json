{
  "name": "more-i-gory-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "concurrently \"pnpm dev:content\" \"pnpm dev:next\"",
    "dev:content": "velite dev --strict",
    "dev:next": "next dev",
    "build": "pnpm content:build && next build",
    "start": "next start",
    "lint": "eslint src scripts next.config.ts velite.config.ts eslint.config.mjs postcss.config.mjs --cache --cache-location .next/eslint.cache",
    "typecheck": "tsc --noEmit",
    "content:build": "velite build --strict",
    "payload": "payload",
    "payload:generate-importmap": "payload generate:importmap",
    "payload:generate-types": "payload generate:types",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "proof:payload-runtime": "node --conditions=react-server node_modules/payload/bin.js run scripts/run-payload-runtime-proof.mjs",
    "db:single:preflight": "node ops/runtime/single-db-migration.mjs preflight",
    "db:single:apply": "node ops/runtime/single-db-migration.mjs apply",
    "db:single:seed-proof": "node --conditions=react-server node_modules/payload/bin.js run scripts/run-preview-db-proof.mjs",
    "media:seed": "node --conditions=react-server node_modules/payload/bin.js run scripts/run-media-seed.mjs",
    "media:seed:dry-run": "node --conditions=react-server scripts/seed-media-assets.mjs --dry-run",
    "regions:seed": "node --conditions=react-server node_modules/payload/bin.js run scripts/run-region-seed.mjs",
    "regions:seed:dry-run": "node --conditions=react-server scripts/seed-regions.mjs --dry-run",
    "bootstrap:owner": "node --conditions=react-server node_modules/payload/bin.js run scripts/bootstrap-owner.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:ui-drift": "node scripts/verify-ui-drift.mjs",
    "verify:content": "node scripts/validate-content.mjs",
    "verify:seo": "node scripts/validate-seo.mjs && node scripts/validate-url-migration-manifest.mjs",
    "verify:url-migration": "node scripts/validate-url-migration-manifest.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:risk:runtime-release": "node scripts/verify-runtime-release.mjs",
    "verify:schema": "node scripts/verify-schema.mjs && node --test tests/seo/route-grammar.test.mjs",
    "verify:guards": "node scripts/verify-architecture-guards.mjs",
    "verify:guards:test": "node --test tests/docs/verify-architecture-guards.test.mjs",
    "verify:quick-coverage": "node scripts/verify-quick-coverage.mjs",
    "report:property-enum-drift": "node --conditions=react-server scripts/report-property-enum-drift.mjs",
    "verify:quick": "node scripts/verify-quick.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:daily": "pnpm verify",
    "verify:sourcecraft-contract": "node --test tests/docs/sourcecraft-contract.test.mjs",
    "quality:dead-code": "knip --dependencies --reporter compact",
    "verify:public-copy": "node scripts/verify-public-copy.mjs",
    "test:ingest": "node scripts/run-test-group.mjs ingest",
    "test:leads": "node scripts/run-test-group.mjs leads",
    "test:seo": "node scripts/run-test-group.mjs seo",
    "test:ui": "node scripts/run-test-group.mjs ui",
    "test:runtime": "node scripts/run-test-group.mjs runtime",
    "test:docs": "node scripts/run-test-group.mjs docs",
    "test:jobs": "node scripts/run-test-group.mjs jobs",
    "test:all": "pnpm test:ingest && pnpm test:leads && pnpm test:seo && pnpm test:ui && pnpm test:runtime && pnpm test:docs && pnpm test:jobs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@more-i-gory/contracts": "workspace:*",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "1.43.0",
    "next": "16.3.6",
    "payload": "3.90.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "knip": "6.35.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "velite": "0.4.0"
  }
}
