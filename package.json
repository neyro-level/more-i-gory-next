{
  "name": "more-i-gory-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "concurrently \"pnpm dev:content\" \"pnpm dev:next\"",
    "dev:content": "velite dev --strict",
    "dev:next": "next dev",
    "build": "pnpm content:build && next build",
    "start": "next start",
    "lint": "eslint src scripts public/assets/lead-form.js next.config.ts velite.config.ts eslint.config.mjs postcss.config.mjs --cache --cache-location .next/eslint.cache",
    "typecheck": "tsc --noEmit",
    "content:build": "velite build --strict",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "verify:ui-drift": "node scripts/verify-ui-drift.mjs",
    "verify:content": "node scripts/validate-content.mjs",
    "verify:seo": "node scripts/validate-seo.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:schema": "pnpm content:build && pnpm verify:content && pnpm verify:seo",
    "verify:quick": "pnpm content:build && pnpm typecheck && pnpm lint && pnpm verify:foundation && pnpm verify:ui-drift && pnpm verify:content && pnpm verify:seo",
    "verify": "pnpm verify:quick && pnpm build && pnpm verify:runtime",
    "verify:daily": "pnpm verify"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "shadcn": "4.21.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "velite": "0.4.0"
  }
}
